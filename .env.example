# ============================================================
# ENVIRONMENT VARIABLES - WEDDING INVITATION (ASRIL & SISI)
# ============================================================
#
# Salin file ini menjadi .env.local untuk pengujian lokal,
# atau masukkan variabel berikut ke Dashboard Vercel (Project Settings -> Environment Variables)
#
# Dapatkan kredensial ini secara gratis di: https://app.supabase.com -> Project Settings -> API

# URL Project Supabase Anda (contoh: https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Anon Public Key (aman digunakan di browser client-side)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service Role Secret Key (hanya untuk server-side / API route, memiliki akses admin penuh)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
